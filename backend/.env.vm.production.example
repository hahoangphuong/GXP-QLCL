APP_ENV=production
DEPLOYMENT_PLATFORM=compute_engine_vm
FRONTEND_TOPOLOGY=nginx_static_proxy
APP_PORT=8000

AUTH_PROVIDER=google_oidc
AUTH_DEFAULT_ROLE=reader
AUTH_ROLE_SOURCE=database
AUTH_ALLOWED_EMAIL_DOMAIN=example.com
AUTH_OIDC_CLIENT_ID=YOUR_GOOGLE_OIDC_CLIENT_ID.apps.googleusercontent.com
AUTH_TRUSTED_HEADER_FALLBACK=false

DB_MODE=local_postgres
DB_DRIVER=postgresql+psycopg
DB_NAME=gxp_qlcl
DB_USER=gxp_app
DB_PASSWORD=__SET_IN_0640_RUNTIME_ENV_FILE__
DB_HOST=127.0.0.1
DB_PORT=5432

STORAGE_CLASS=synology_smb
STORAGE_INSPECTION_ROOT=\\\\100.95.45.127\\Hồ sơ nội bộ\\01 - Kiểm tra GPs
STORAGE_DKKD_ROOT=\\\\100.95.45.127\\Hồ sơ nội bộ\\01 - Kiểm tra GPs\\Chứng nhận ĐĐKKDD
STORAGE_TEMPLATE_ROOT=\\\\100.95.45.127\\Hồ sơ nội bộ\\01 - Kiểm tra GPs\\Templates
SMB_USERNAME=__SET_IN_0640_RUNTIME_ENV_FILE__
SMB_PASSWORD=__SET_IN_0640_RUNTIME_ENV_FILE__
SMB_AUTH_PROTOCOL=ntlm
SMB_PORT=445
SMB_ENCRYPT=false
SMB_CONNECTION_TIMEOUT_SECONDS=60

VM_APP_ROOT=/opt/gxp
VM_APP_USER=gxp
VM_APP_GROUP=gxp
VM_PYTHON_SERIES=3.12
VM_PYTHON_BIN=/usr/bin/python3.12
VM_SRC_DIR=/opt/gxp/src/GXP-QLCL
VM_BACKEND_RELEASES_DIR=/opt/gxp/backend-releases
VM_BACKEND_VENV_RELEASES_DIR=/opt/gxp/backend-venvs
VM_CURRENT_BACKEND_RELEASE_LINK=/opt/gxp/current-backend
VM_CURRENT_BACKEND_VENV_LINK=/opt/gxp/current-venv
VM_FRONTEND_DIST_DIR=/opt/gxp/frontend-dist
GXP_FRONTEND_DIST_ROOT=/opt/gxp/frontend-dist
VM_FRONTEND_RELEASES_DIR=/opt/gxp/frontend-releases
VM_RUNTIME_ENV_FILE=/etc/gxp/runtime.env
VM_RELEASE_METADATA_FILE=/opt/gxp/current-release.json
VM_RELEASE_RETENTION_COUNT=3
SYSTEMD_SERVICE_NAME=gxp-web
NGINX_SITE_NAME=gxp-web
NGINX_SERVER_NAME=gxp.example.com
VM_TLS_CERT_PATH=/etc/ssl/certs/gxp.crt
VM_TLS_KEY_PATH=/etc/ssl/private/gxp.key
VM_TLS_PROVISIONING_MODE=existing_files
VM_SWAP_SIZE_GB=4
VM_SWAPPINESS=10
VM_NODE_MAJOR=22
VM_NODE_MIN_VERSION=22.12.0
VM_COREPACK_VERSION=0.31.0
VM_NODE_PACKAGE_MANAGER=pnpm@11.19.0
VM_NODE_BUILD_OPTIONS=--max-old-space-size=512
VM_SUPPORTED_POSTGRES_MAJORS=17,18
PG_SHARED_BUFFERS_MB=256
PG_EFFECTIVE_CACHE_SIZE_MB=768
PG_WORK_MEM_MB=4
PG_MAINTENANCE_WORK_MEM_MB=64
PG_AUTOVACUUM_WORK_MEM_MB=64
PG_MAX_CONNECTIONS=30
PUBLIC_BASE_URL=https://gxp.example.com
BACKUP_GCS_BUCKET=gs://YOUR_GXP_BACKUP_BUCKET
BACKUP_LOCAL_STAGING_DIR=/var/backups/gxp-temp
DEPLOY_BRANCH=main
