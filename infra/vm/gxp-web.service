[Unit]
Description=GxP Web Backend
After=network-online.target postgresql.service tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User={{VM_APP_USER}}
Group={{VM_APP_GROUP}}
WorkingDirectory={{VM_SERVICE_WORKING_DIRECTORY}}
EnvironmentFile={{VM_SERVICE_ENVIRONMENT_FILE}}
ExecStart={{VM_SERVICE_EXECUTABLE}} backend.app.main:app --host 127.0.0.1 --port {{APP_PORT}}
Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
