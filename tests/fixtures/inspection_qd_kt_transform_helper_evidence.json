  "functions": {
    "DelLastIf_Ins": {
      "module": "WinAPI.bas",
      "start_line": 504,
      "end_line": 510,
      "source": [
        "Public Function DelLastIf_Ins(ByVal s$, ByVal si$) As String",
        "    Do While s <> vbNullString",
        "        If InStr(1, si, Right$(s, 1), vbTextCompare) > 0 Then s = Left$(s, Len(s) - 1) Else GoTo Quit0",
        "    Loop",
        "Quit0:",
        "    DelLastIf_Ins = s",
        "End Function"
      ]
    },
    "LCase_FirstChar": {
      "module": "WinAPI.bas",
      "start_line": 552,
      "end_line": 555,
      "source": [
        "Public Function LCase_FirstChar$(ByVal s$)",
        "    If s = vbNullString Then Exit Function",
        "    LCase_FirstChar = LCase$(Left$(s, 1)) & Right$(s, Len(s) - 1)",
        "End Function"
      ]
    },
    "Del_LastPeriod": {
      "module": "WinAPI.bas",
      "start_line": 559,
      "end_line": 561,
      "source": [
        "Public Function Del_LastPeriod$(ByVal s$)",
        "    If Right$(s, 1) = \".\" Then Del_LastPeriod = Left$(s, Len(s) - 1) Else Del_LastPeriod = s",
        "End Function"
      ]
    }
  },
