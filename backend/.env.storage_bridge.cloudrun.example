DEPLOYMENT_PLATFORM=google_cloud_run
BRIDGE_RUNTIME=storage_bridge

STORAGE_CLASS=synology_smb_bridge
STORAGE_INSPECTION_ROOT=\\\\100.95.45.127\\Hồ sơ nội bộ\\01 - Kiểm tra GPs
STORAGE_DKKD_ROOT=\\\\100.95.45.127\\Hồ sơ nội bộ\\01 - Kiểm tra GPs\\Chứng nhận ĐĐKKDD
STORAGE_TEMPLATE_ROOT=\\\\100.x.x.x\\REPLACE_SHARE\\Templates

SMB_AUTH_PROTOCOL=ntlm
SMB_PORT=445
SMB_ENCRYPT=false
SMB_CONNECTION_TIMEOUT_SECONDS=60

BRIDGE_AUTH_MODE=google_oidc
# Leave STORAGE_BRIDGE_AUTH_AUDIENCE unset for the first bootstrap-safe deploy.
# bootstrap_storage_bridge.sh will redeploy the final revision with the actual Cloud Run status.url.
TAILSCALE_ENABLE=1
TAILSCALE_HOSTNAME=gxp-storage-bridge
