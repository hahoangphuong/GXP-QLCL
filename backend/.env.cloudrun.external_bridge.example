APP_NAME=GxP Web
APP_MODE=application_foundation
DEPLOYMENT_PLATFORM=google_cloud_run

AUTH_MODE=google_iap_jwt
AUTH_DEFAULT_ROLE=reader
AUTH_ROLE_SOURCE=database
AUTH_IAP_EXPECTED_AUDIENCE=/projects/PROJECT_NUMBER/global/backendServices/BACKEND_SERVICE_ID
AUTH_IAP_ALLOWED_EMAIL_DOMAIN=example.com
AUTH_TRUSTED_HEADER_FALLBACK=false

DB_DRIVER=postgresql+psycopg
DB_NAME=gxp_qlcl
DB_USER=gxp_app
DB_PASSWORD=__INJECT_FROM_SECRET_MANAGER__
CLOUD_SQL_CONNECTION_NAME=gxp-project-id:asia-southeast1:gxp-qlcl-db

STORAGE_CLASS=external_bridge_http
STORAGE_BRIDGE_BASE_URL=https://gxp-storage-bridge-12345-asia-southeast1.run.app
STORAGE_BRIDGE_AUTH_AUDIENCE=https://gxp-storage-bridge-12345-asia-southeast1.run.app
