APP_ENV=production
APP_NAME=GxP Web
APP_MODE=application_foundation
DEPLOYMENT_PLATFORM=google_cloud_run
FRONTEND_TOPOLOGY=single_cloud_run_service

AUTH_MODE=google_iap_jwt
AUTH_ROLE_SOURCE=database
AUTH_IAP_EXPECTED_AUDIENCE=/projects/PROJECT_NUMBER/locations/asia-southeast1/services/gxp-web
AUTH_IAP_ALLOWED_EMAIL_DOMAIN=example.com
AUTH_TRUSTED_HEADER_FALLBACK=false

DB_DRIVER=postgresql+psycopg
DB_NAME=gxp_qlcl
DB_USER=gxp_app
DB_PASSWORD=__INJECT_FROM_SECRET_MANAGER__
CLOUD_SQL_CONNECTION_NAME=gxp-qlcl:asia-southeast1:gxp-db

STORAGE_CLASS=external_bridge_http
STORAGE_BRIDGE_BASE_URL=https://REPLACE-WITH-ACTUAL-BRIDGE-RUN-URL
STORAGE_BRIDGE_AUTH_AUDIENCE=https://REPLACE-WITH-ACTUAL-BRIDGE-RUN-URL
BRIDGE_AUTH_MODE=google_oidc

CLOUD_RUN_SERVICE_NAME=gxp-web
