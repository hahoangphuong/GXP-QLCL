{
  "name": "gxp-qlcl-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "dev": "pnpm exec vite",
    "lint": "pnpm exec eslint src --ext .ts,.tsx",
    "typecheck": "pnpm exec tsc --noEmit -p tsconfig.app.json && pnpm exec tsc --noEmit -p tsconfig.node.json",
    "test": "pnpm exec vitest run",
    "build": "pnpm exec tsc -b && pnpm exec vite build",
    "preview": "pnpm exec vite preview"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2"
  },
  "devDependencies": {
    "@eslint/js": "9.38.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.38.0",
    "globals": "16.4.0",
    "jsdom": "27.0.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "7.3.6",
    "vitest": "3.2.7"
  }
}
